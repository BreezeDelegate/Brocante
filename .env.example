# API
PORT=8787
# Required in production unless a trusted private/IAP boundary replaces API authentication.
# Generate a long random value and keep the real secret outside Git.
API_TOKEN=
# Keep 0 for normal production deployments.
ALLOW_UNAUTHENTICATED=0
# Leave empty for same-origin deployments; otherwise use an explicit comma-separated allowlist.
CORS_ORIGINS=
# Enable only when exactly one trusted reverse proxy is in front of the API.
TRUST_PROXY=0
JSON_LIMIT=8mb
REQUESTS_PER_MINUTE=90

# Timeouts, queue and cache
IDENTIFY_TIMEOUT_MS=45000
PROVIDER_TIMEOUT_MS=35000
PROVIDER_MAX_QUEUE=20
CACHE_TTL_MS=900000
CACHE_MAX_ENTRIES=500

# Local vision model. Keep Ollama private; Docker Compose overrides this to the host gateway.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b

# Marketplace pacing
VINTED_GAP_MS=2500
LEBONCOIN_GAP_MS=3000
