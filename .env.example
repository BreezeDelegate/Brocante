# API
PORT=8787
API_TOKEN=
ALLOW_UNAUTHENTICATED=0
CORS_ORIGINS=
TRUST_PROXY=0
JSON_LIMIT=8mb
REQUESTS_PER_MINUTE=90

# Timeouts, queue and cache
IDENTIFY_TIMEOUT_MS=45000
PROVIDER_TIMEOUT_MS=35000
PROVIDER_MAX_QUEUE=20
CACHE_TTL_MS=900000
CACHE_MAX_ENTRIES=500

# Local vision model
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b

# Marketplace pacing
VINTED_GAP_MS=2500
LEBONCOIN_GAP_MS=3000
EBAY_GAP_MS=1000

# eBay Browse API (optional, server-side only)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
